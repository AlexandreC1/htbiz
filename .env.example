# Copy to .env and fill in. .env is gitignored and bundled as a Flutter asset
# (see pubspec.yaml), so these values ship inside the app — none of them are
# server-side secrets, and none of them should ever be a service_role key.
#
# What actually protects these is configuration, not secrecy:
#   * Supabase anon key  -> Row Level Security
#   * Firebase API key   -> Security Rules, App Check
#   * Google Maps key    -> Android package + SHA-1 restriction, API allow-list,
#                           and a billing budget alert

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# From `flutterfire configure`, or the Firebase console project settings.
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=1:000000000000:android:0000000000000000000000
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_IOS_BUNDLE_ID=com.htbiz.htbiz

# Used by the Dart side (Static Maps / Geocoding). The Android native map also
# needs this same value in android/local.properties as GOOGLE_MAPS_API_KEY,
# which build.gradle.kts injects into the manifest.
GOOGLE_MAPS_API_KEY=
